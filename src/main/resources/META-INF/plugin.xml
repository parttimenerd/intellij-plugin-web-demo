<idea-plugin>
    <id>me.bechberger.webdemo</id>
    <name>IntelliJ Web Demo</name>
    <vendor email="me@mostlynerdless.de">Johannes Bechberger</vendor>
    <idea-version since-build="252"/>

    <depends>com.intellij.modules.java</depends>

    <!--
        JCEF moved from the platform core to a separate bundled plugin (com.intellij.modules.jcef)
        in IntelliJ 2026.2+. Declaring it as optional prevents ClassNotFoundException on IDEs
        where JCEF is absent or has moved. The tool window (which embeds JBCefBrowser) is in
        jcef.xml so it is only registered when JCEF is available.
        Lesson learned from jfrplugin: https://github.com/parttimenerd/intellij-profiler-plugin
    -->
    <depends optional="true" config-file="jcef.xml">com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService
            serviceImplementation="me.bechberger.webdemo.ClassBrowserServer"/>
    </extensions>

    <actions>
        <action id="me.bechberger.webdemo.OpenBrowser"
                class="me.bechberger.webdemo.OpenBrowserAction"
                text="Open Class Browser"
                description="Open the embedded class browser web app">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="me.bechberger.webdemo.SetFilter"
                class="me.bechberger.webdemo.SetFilterAction"
                text="Browse This Class"
                description="Send this class to the Class Browser">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
