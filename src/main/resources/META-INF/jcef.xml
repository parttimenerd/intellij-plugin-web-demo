<idea-plugin>
    <!--
        Extensions that directly reference JBCefBrowser/JBCefBrowserBuilder live here.
        This file is only loaded when com.intellij.modules.jcef is available, preventing
        ClassNotFoundException on IDEs where JCEF has moved to a separate bundled plugin
        (IntelliJ 2026.2+ / 263.x).
    -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="Class Browser"
            anchor="left"
            icon="/toolwindows/webToolWindow.svg"
            factoryClass="me.bechberger.webdemo.ClassBrowserToolWindowFactory"/>
    </extensions>
</idea-plugin>
